<svg width="1280" height="720" viewBox="0 0 1280 720" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="1280" height="720" fill="#0F1419"/>
  <rect x="0" y="0" width="1280" height="80" fill="#1A1F2E"/>
  <rect x="30" y="16" width="200" height="48" rx="12" fill="#2D3E52"/>
  <text x="62" y="48" fill="#FFFFFF" font-family="Arial, sans-serif" font-size="24" font-weight="700">MuzlaPay</text>
  <text x="1000" y="48" fill="#8892A8" font-family="Arial, sans-serif" font-size="18">Home</text>

  <rect x="0" y="80" width="1280" height="640" fill="#0A0E17"/>
  <rect x="40" y="100" width="1200" height="600" rx="20" fill="#1B2332"/>
  
  <rect x="60" y="120" width="1160" height="140" rx="16" fill="#2A3A4F" stroke="#3D4A5F"/>
  <text x="90" y="165" fill="#FFFFFF" font-family="Arial, sans-serif" font-size="28" font-weight="700">Secure Escrow Payment</text>
  <text x="90" y="200" fill="#B0B8C5" font-family="Arial, sans-serif" font-size="18">Trust-based transactions for Telegram & online stores</text>
  <text x="90" y="235" fill="#7A8A9E" font-family="Arial, sans-serif" font-size="16">Buyer-Seller-Mediator protected flow</text>

  <rect x="60" y="280" width="550" height="380" rx="16" fill="#141B27" stroke="#2A3842"/>
  <text x="90" y="320" fill="#FFFFFF" font-family="Arial, sans-serif" font-size="20" font-weight="700">Payment Details</text>
  
  <rect x="90" y="350" width="490" height="48" rx="10" fill="#1E2A38"/>
  <text x="110" y="383" fill="#8892A8" font-family="Arial, sans-serif" font-size="16">Product ID or Link</text>

  <rect x="90" y="415" width="490" height="48" rx="10" fill="#1E2A38"/>
  <text x="110" y="448" fill="#8892A8" font-family="Arial, sans-serif" font-size="16">Amount (USD)</text>

  <rect x="90" y="480" width="490" height="48" rx="10" fill="#1E2A38"/>
  <text x="110" y="513" fill="#8892A8" font-family="Arial, sans-serif" font-size="16">Telegram Username</text>

  <rect x="90" y="545" width="200" height="50" rx="12" fill="#4CAF50"/>
  <text x="115" y="577" fill="#FFFFFF" font-family="Arial, sans-serif" font-size="18" font-weight="700">Pay Now</text>

  <rect x="640" y="280" width="550" height="380" rx="16" fill="#141B27" stroke="#2A3842"/>
  <text x="670" y="320" fill="#FFFFFF" font-family="Arial, sans-serif" font-size="20" font-weight="700">Transaction Status</text>
  
  <rect x="670" y="355" width="490" height="70" rx="12" fill="#1A3A2A" stroke="#2D5A3D"/>
  <text x="690" y="382" fill="#7FD9B5" font-family="Arial, sans-serif" font-size="14">Status: Awaiting Payment</text>
  <text x="690" y="410" fill="#B0D9C8" font-family="Arial, sans-serif" font-size="16" font-weight="700">$150.00 USD</text>

  <rect x="670" y="445" width="490" height="70" rx="12" fill="#1E2A38" stroke="#2A3842"/>
  <text x="690" y="472" fill="#8892A8" font-family="Arial, sans-serif" font-size="14">Mediator</text>
  <text x="690" y="500" fill="#FFFFFF" font-family="Arial, sans-serif" font-size="16">admin_mediation</text>

  <rect x="670" y="535" width="490" height="70" rx="12" fill="#1E2A38" stroke="#2A3842"/>
  <text x="690" y="562" fill="#8892A8" font-family="Arial, sans-serif" font-size="14">Time Remaining</text>
  <text x="690" y="590" fill="#FFD700" font-family="Arial, sans-serif" font-size="18" font-weight="700">23h 45m</text>
</svg>
